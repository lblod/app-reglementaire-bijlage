PREFIX gn: <http://data.lblod.info/vocabularies/gelinktnotuleren/>

DELETE {
  GRAPH ?g {
    ?s a gn:Tag .
    ?s ?p ?o.
  }
} INSERT {
  GRAPH <http://mu.semte.ch/graphs/public> {
    ?s a gn:Tag .
    ?s ?p ?o.
  }
} WHERE {
  GRAPH ?g {
    ?s a gn:Tag .
    ?s ?p ?o.
  }
  FILTER(?g != <http://mu.semte.ch/graphs/public>)
}